[Unit]
Description=Sendspin Router
# The MQTT broker (ioBroker) runs on another host. The router reconnects to
# it on its own, so only the network is required, not a local broker.
After=network-online.target systemd-tmpfiles-setup.service
Wants=network-online.target
RequiresMountsFor=/home/pi/sendspin-router

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/sendspin-router
ExecStart=/home/pi/sendspin-router/.venv/bin/sendspin-router --config /home/pi/sendspin-router/config/config.yaml
Restart=on-failure
RestartSec=5
# Shutdown needs well under a second; don't wait the default 90 s if it hangs.
TimeoutStopSec=15
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
